{
  "_help": "Map for agents and CI. 'docs': which document to review when certain files change (used by update-docs, implement-issue and review-pr). 'sensitive': paths that must be asked about before changing them and that need /security-review (see AGENTS.md, Agent autonomy). 'verify': what to run before the PR according to what changed (scripts/agents/verify.py). 'red': how red.sh gets the structured report of each test stack (ADR-002 D2): name, when (globs of changed files), run (with {out}), format (junit|tap), optional timeout in seconds. 'required': documents that must exist (validated by scripts/agents/check-docs.py). 'ignore_check': paths that check-docs.py does not validate, such as historical logs that cite files that no longer exist. Git-style globs: ** any depth, * one level. A path that starts with ? is optional: check-docs does not fail if it matches no file (useful for stack alternatives, such as package.json or *.lock). 'parity': true|false, switch of the language-parity check (each X.md with its X.es.md): the template turns it on while its content is translated and the init turns it off in projects, which have a single language. 'parity_ignore': .md files that have no .es.md version (the language-parity check; ignore_check does not exempt them). The project's own paths go without ?: if they stop existing, the check fails. TODO: fill in with the project's paths.",
  "docs": [
    {
      "when": [
        "TODO/schema/**",
        "?**/migrations/**"
      ],
      "review": [
        "docs/reference/domain.md",
        "docs/development/architecture.md"
      ],
      "reason": "the data model changed"
    },
    {
      "when": [
        "TODO/api/routes/**"
      ],
      "review": [
        "docs/development/architecture.md",
        "docs/reference/surfaces.md"
      ],
      "reason": "an endpoint or a screen changed"
    },
    {
      "when": [
        "TODO/modules/**"
      ],
      "review": [
        "docs/reference/modules.md"
      ],
      "reason": "a module's responsibility changed"
    },
    {
      "when": [
        "?package.json",
        "?**/package.json",
        "?.github/workflows/**"
      ],
      "review": [
        "AGENTS.md",
        "docs/development/setup.md"
      ],
      "reason": "a command, a dependency or the CI changed"
    },
    {
      "when": [
        "?infra/**",
        "?Dockerfile",
        "?**/*.toml"
      ],
      "review": [
        "docs/development/deploy.md"
      ],
      "reason": "the infrastructure or the deploy changed"
    },
    {
      "when": [
        ".claude/agents/**",
        "?.claude/i18n/agents/**",
        "docs/agents/subagent-contract.md"
      ],
      "review": [
        "AGENTS.md",
        "README.md",
        "docs/agents/subagent-contract.md"
      ],
      "reason": "a subagent (model, tools, escalation) or its contract changed"
    },
    {
      "when": [
        ".claude/settings.json",
        "scripts/agents/guardrails.py",
        ".codex/hooks.json",
        ".github/hooks/**",
        ".cursor/hooks.json"
      ],
      "review": [
        "AGENTS.md",
        "README.md"
      ],
      "reason": "the guardrails changed (which commands the hook stops)"
    }
  ],
  "sensitive": [
    {
      "type": "schema",
      "paths": [
        "TODO/schema/**",
        "?**/migrations/**"
      ],
      "skill": "db-migration"
    },
    {
      "type": "auth",
      "paths": [
        "TODO/auth/**",
        "?**/middleware/**"
      ]
    },
    {
      "type": "money",
      "paths": [
        "TODO/payments/**"
      ]
    },
    {
      "type": "dependencies",
      "paths": [
        "?package.json",
        "?**/package.json",
        "?*.lock",
        "?pnpm-lock.yaml"
      ]
    },
    {
      "type": "infra",
      "paths": [
        "?infra/**",
        "?.github/workflows/**",
        "?Dockerfile",
        ".claude/settings.json",
        "scripts/agents/guardrails.py",
        ".codex/hooks.json",
        ".github/hooks/**",
        ".cursor/hooks.json"
      ]
    },
    {
      "type": "public-api",
      "paths": [
        "TODO/public-api/**"
      ]
    }
  ],
  "red": [
    {
      "name": "bash",
      "when": [
        "**/test-*.sh"
      ],
      "format": "tap",
      "run": "rc=0; while IFS= read -r -d '' t; do TAP_OUT={out} bash \"$t\" || rc=1; grep -qxF \"# file: $t\" {out} || echo \"Bail out! $t wrote no TAP\" >>{out}; done < <(git diff -z --name-only --diff-filter=AM HEAD^ HEAD -- ':(glob)**/test-*.sh'); exit $rc",
      "timeout": 1800
    }
  ],
  "verify": [
    {
      "name": "docs",
      "always": true,
      "run": "python3 scripts/agents/check-docs.py"
    },
    {
      "name": "shellcheck",
      "when": [
        "**/*.sh"
      ],
      "run": "command -v shellcheck >/dev/null || { echo 'shellcheck is missing: brew install shellcheck (macOS) or apt install shellcheck. This check does not run without it.'; exit 1; }; shellcheck {files}"
    },
    {
      "name": "prepare",
      "when": [
        ".claude/skills/implement-issue/prepare.sh",
        ".claude/skills/implement-issue/test-prepare.sh"
      ],
      "run": "bash .claude/skills/implement-issue/test-prepare.sh"
    },
    {
      "name": "agents",
      "when": [
        ".claude/agents/**",
        "?.claude/i18n/agents/**",
        "docs/agents/subagent-contract.md",
        "scripts/agents/check-docs.py",
        "scripts/agents/test-agents.sh"
      ],
      "run": "bash scripts/agents/test-agents.sh"
    },
    {
      "name": "red",
      "when": [
        ".claude/skills/implement-issue/red.sh",
        ".claude/skills/implement-issue/test-red.sh",
        ".claude/skills/implement-issue/corpus/**",
        "scripts/agents/red_report.py"
      ],
      "run": "bash .claude/skills/implement-issue/test-red.sh"
    },
    {
      "name": "orchestrate",
      "when": [
        ".claude/skills/orchestrate/**",
        ".claude/agents/reviewer.md",
        ".claude/skills/implement-issue/SKILL.md",
        ".gitignore",
        ".github/workflows/labels.yml",
        "?profiles/small/DELETE"
      ],
      "run": "bash .claude/skills/orchestrate/test-orchestrate.sh"
    },
    {
      "name": "labels-check",
      "when": [
        ".github/workflows/labels.yml",
        "scripts/agents/test-labels-check.sh"
      ],
      "run": "bash scripts/agents/test-labels-check.sh"
    },
    {
      "name": "retros",
      "when": [
        ".claude/skills/improve-skills/**"
      ],
      "run": "bash .claude/skills/improve-skills/test-retros.sh"
    },
    {
      "name": "i18n",
      "when": [
        "scripts/agents/check-docs.py",
        "scripts/agents/agents_map.py",
        "scripts/agents/test-i18n.sh",
        "scripts/init-template.sh",
        ".claude/agents/**",
        "?.claude/i18n/**",
        ".claude/skills/*/SKILL.md",
        ".github/workflows/docs.yml",
        ".claude/skills/**/*.es.md",
        ".claude/skills/improve-skills/retro-template.md",
        "scripts/agents/test-agents.sh",
        ".claude/skills/orchestrate/test-orchestrate.sh",
        ".claude/skills/improve-skills/test-retros.sh"
      ],
      "run": "bash scripts/agents/test-i18n.sh"
    },
    {
      "name": "tap",
      "when": [
        "scripts/agents/tap.sh",
        "scripts/agents/test-tap.sh",
        "**/test-*.sh"
      ],
      "run": "bash scripts/agents/test-tap.sh"
    },
    {
      "name": "base",
      "when": [
        "scripts/agents/**"
      ],
      "run": "bash scripts/agents/test-base.sh"
    },
    {
      "name": "guardrails",
      "when": [
        ".claude/settings.json",
        "scripts/agents/guardrails.py",
        "scripts/agents/test_guardrails.py",
        ".codex/hooks.json",
        ".github/hooks/**",
        ".cursor/hooks.json"
      ],
      "run": "python3 -m unittest scripts/agents/test_guardrails.py"
    },
    {
      "name": "init",
      "when": [
        "?scripts/init-template.sh",
        "?scripts/test-init.sh"
      ],
      "run": "bash scripts/test-init.sh"
    },
    {
      "name": "update",
      "when": [
        "?scripts/update.py",
        "?scripts/test-update.sh",
        "?scripts/init-template.sh"
      ],
      "run": "bash scripts/test-update.sh"
    },
    {
      "name": "install",
      "when": [
        "?scripts/install.py",
        "?scripts/test-install.sh",
        "?scripts/update.py",
        "?scripts/agents/labels.py",
        "?scripts/init-template.sh"
      ],
      "run": "bash scripts/test-install.sh"
    },
    {
      "name": "renames",
      "when": [
        "?scripts/test-renames.sh",
        "scripts/**",
        ".claude/**",
        ".github/**",
        "docs/**",
        "profiles/**",
        "*.md"
      ],
      "run": "bash scripts/test-renames.sh"
    },
    {
      "name": "lint",
      "always": true,
      "run": "TODO: lint command (for example: npm run lint)"
    },
    {
      "name": "typecheck",
      "always": true,
      "run": "TODO: typecheck command (for example: npx tsc --noEmit)"
    },
    {
      "name": "tests",
      "always": true,
      "run": "TODO: the tests, ideally only the affected ones (for example: npx vitest related {files} --run)"
    },
    {
      "name": "migrations",
      "when": [
        "TODO/schema/**",
        "?**/migrations/**"
      ],
      "run": "TODO: check that the schema and the migrations match (generate and check that nothing is left uncommitted)"
    },
    {
      "name": "api-contract",
      "when": [
        "TODO/public-api/**"
      ],
      "run": "TODO: compare the public contract against the base (for example: an OpenAPI diff)"
    }
  ],
  "required": [
    "AGENTS.md",
    "docs/README.md",
    "docs/llms.txt",
    "docs/github-naming-convention.md",
    "docs/decisions/README.md",
    "docs/development/architecture.md"
  ],
  "ignore_check": [
    "profiles/**",
    "CHANGELOG.md",
    "docs/decisions/ADR-001-*"
  ],
  "parity": true,
  "parity_ignore": [
    "CHANGELOG.md",
    "CLAUDE.md",
    "docs/decisions/ADR-001-*"
  ]
}
